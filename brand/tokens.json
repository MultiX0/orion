{
  "$name": "Orion",
  "$description": "Orion design tokens — dark-only system. Mirrors tokens.css.",
  "$version": "1.0.0",
  "color": {
    "bg": {
      "primary": "#09090b",
      "secondary": "#0f0f12",
      "card": "#111115",
      "cardElevated": "#16161c",
      "highlight": "#1a2535"
    },
    "text": {
      "white": "#f4f4f5",
      "muted": "#71717a",
      "faint": "#3f3f46",
      "cyan": "#a8ccd8",
      "cyanSoft": "#7cb8ce"
    },
    "border": {
      "subtle": "rgba(255,255,255,0.06)",
      "soft": "rgba(255,255,255,0.10)",
      "cyan": "rgba(160,210,230,0.20)"
    },
    "accent": {
      "base": "#a8ccd8",
      "rgb": "168, 204, 216",
      "glowRgb": "160, 210, 230",
      "alphas": {
        "wash": 0.03,
        "ambient": 0.05,
        "fill": 0.1,
        "border": 0.2,
        "borderHover": 0.4,
        "glow": 0.5
      }
    }
  },
  "font": {
    "family": {
      "serif": "'Playfair Display', Georgia, serif",
      "body": "'Source Serif 4', Georgia, serif",
      "sans": "'Inter', system-ui, sans-serif",
      "mono": "'DM Mono', 'Courier New', monospace"
    },
    "role": {
      "display": "serif",
      "document": "body",
      "ui": "sans",
      "machine": "mono"
    },
    "size": {
      "monumental": "clamp(120px, 25vw, 360px)",
      "hero": "clamp(32px, 3.6vw, 58px)",
      "section": "clamp(28px, 3vw, 44px)",
      "cardTitle": "24px",
      "lead": "clamp(14px, 1.1vw, 16px)",
      "body": "15px",
      "ui": "14px",
      "uiSmall": "12px",
      "label": "10px",
      "micro": "8px"
    },
    "weight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "monumental": 0.9,
      "display": 1.08,
      "title": 1.2,
      "body": 1.65,
      "article": 1.75
    },
    "tracking": {
      "monumental": "-0.05em",
      "display": "-0.025em",
      "tight": "-0.02em",
      "ui": "0.02em",
      "label": "0.15em",
      "eyebrow": "0.18em",
      "micro": "0.22em",
      "microWide": "0.28em"
    }
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "15": "60px",
    "20": "80px",
    "25": "100px",
    "30": "120px"
  },
  "container": {
    "wide": "1400px",
    "hero": "1360px",
    "default": "1200px",
    "narrow": "968px",
    "article": "800px",
    "measure": "600px",
    "form": "440px"
  },
  "breakpoint": {
    "lg": "968px",
    "md": "768px",
    "sm": "640px"
  },
  "radius": {
    "xs": "2px",
    "sm": "8px",
    "btn": "10px",
    "card": "12px",
    "lg": "14px",
    "full": "50%"
  },
  "motion": {
    "ease": {
      "brand": "cubic-bezier(0.16, 1, 0.3, 1)",
      "ui": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "duration": {
      "fast": "200ms",
      "hover": "300ms",
      "med": "400ms",
      "keyframe": "700ms",
      "reveal": "1400ms",
      "fade": "1800ms",
      "pulse": "2500ms"
    },
    "stagger": "100ms"
  },
  "shadow": {
    "glowSm": "0 0 8px rgba(168, 204, 216, 0.5)",
    "glowMd": "0 0 16px rgba(168, 204, 216, 0.8)",
    "glowHover": "0 0 24px rgba(168, 204, 216, 0.1)"
  },
  "z": {
    "ambient": 0,
    "content": 1,
    "raised": 5,
    "nav": 50,
    "modal": 100
  }
}
