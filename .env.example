# Copy to .env and fill in. .env is gitignored: never commit it.
# Only the development scripts in tools/ and tool/ read it. The app and the
# board never do; they get their keys during setup.

FISH_API_KEY=
DEEPINFRA_API_KEY=
WIFI_SSID=
WIFI_PASSWORD=

# Optional. Leave empty for the defaults.
# Fish voice id. Empty uses Orion Voice.
FISH_VOICE_ID=
# Fish text to speech model.
FISH_TTS_MODEL=
# Language model id on DeepInfra. Empty uses the firmware's default.
LLM_MODEL=
# The phrase to train in wakeword/.
WAKE_PHRASE=Orion
# tools/cloud/provision.py also takes LLM_*, STT_* and TTS_* names for other
# providers; its header lists them.
